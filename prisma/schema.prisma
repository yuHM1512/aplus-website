// Prisma Schema - Aplus Technologies
// Production: Neon PostgreSQL (Singapore)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// ─── Blog ───────────────────────────────────────────────
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?            // Lên lịch xuất bản
  viewCount   Int      @default(0) // Lượt xem bài viết
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // AI metadata
  aiGenerated Boolean  @default(false)
  aiModel     String?
  aiPrompt    String?

  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  tags        Tag[]

  // Chiến dịch marketing
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  campaignId  String?

  @@map("posts")
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]

  @@map("categories")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]

  @@map("tags")
}

// ─── Contact Form ───────────────────────────────────────
model ContactSubmission {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  needType    String
  description String?
  status      String   @default("new") // new | read | replied
  createdAt   DateTime @default(now())

  @@map("contact_submissions")
}

// ─── Survey Form (Khảo sát chất lượng nước) ─────────────
model SurveySubmission {
  id           String   @id @default(cuid())
  fullName     String
  phone        String
  email        String?              // Tùy chọn — dùng để gửi email xác nhận
  address      String               // Địa chỉ lắp đặt (free text)
  waterSources String[]             // Nguồn nước: nuoc_may | gieng_khoan | khac
  houseType    String               // Loại nhà: biet_thu | nha_dat | chung_cu | khac
  budget       String               // Mức đầu tư: duoi_30tr | 30_60tr | ...
  issues       String[]             // Các vấn đề nước khách gặp (label đầy đủ)
  status       String   @default("new") // new | contacted | closed

  // Sapo integration — customer được tạo/cập nhật trên Sapo từ khảo sát này
  sapoCustomerId Int?

  createdAt    DateTime @default(now())

  @@map("survey_submissions")
}

// ─── Products ───────────────────────────────────────────
model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  image         String?
  category      String?
  categoryName  String?
  brand         String?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  price         String?          // Display string: "990.000"
  priceOriginal String?
  priceNumeric  Int?             // Giá tính toán (VNĐ), dùng cho cart
  badge         String?
  specs         String?          // JSON string for technical specs
  stock         Int      @default(-1) // -1 = không quản lý tồn kho, 0 = hết hàng
  sku           String?          // Mã sản phẩm
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("products")
}

// ─── Orders ─────────────────────────────────────────────
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique  // APL-YYYYMMDD-XXX
  status        String      @default("pending")
                // pending → confirmed → shipping → delivered → cancelled
  paymentMethod String      // bank_transfer | cod
  paymentStatus String      @default("unpaid") // unpaid | paid
  source        String      @default("website") // website | sapo | manual

  // Sapo integration
  sapoOrderId           Int?      @unique  // ID đơn trên Sapo
  sapoOrderNumber       Int?               // Mã đơn hiển thị trên Sapo
  sapoFinancialStatus   String?            // pending | paid | refunded | ...
  sapoFulfillmentStatus String?            // null | partial | fulfilled
  lastSyncedAt          DateTime?          // Lần sync gần nhất từ Sapo

  // Thông tin khách hàng
  fullName      String
  phone         String
  email         String
  province      String
  district      String
  ward          String
  address       String
  note          String?

  // Tổng tiền (VNĐ)
  subtotal      Int
  shippingFee   Int         @default(30000)
  total         Int

  // Khách bấm "Tôi đã chuyển khoản" — timestamp để admin đối soát
  paymentNotifiedAt DateTime?

  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productName  String  // Snapshot tên SP tại thời điểm đặt
  productImage String?
  productSlug  String?
  price        Int     // Giá tại thời điểm đặt (VNĐ)
  quantity     Int

  @@map("order_items")
}

// ─── Campaign (Chiến dịch marketing) ───────────────────
model Campaign {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  status      String   @default("planning") // planning | active | paused | completed
  startDate   DateTime?
  endDate     DateTime?
  color       String   @default("#006EF5")  // Màu hiển thị trên calendar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts       Post[]
  popups      Popup[]

  @@map("campaigns")
}

// ─── Popup / Banner ─────────────────────────────────────
model Popup {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("popup") // popup | top_banner | landing_hero
  // Nội dung: upload ảnh HOẶC paste HTML
  contentType String   @default("image") // image | html
  imageUrl    String?                     // URL ảnh đã upload (PNG/JPEG/PDF)
  htmlContent String?                     // HTML code do admin paste vào
  linkUrl     String?                     // Click vào popup → điều hướng tới đâu
  linkTarget  String   @default("_self")  // _self | _blank

  // Hiển thị
  position    String   @default("center") // center | top | bottom | fullscreen
  showOnPages String[] @default(["/"]) // Trang nào hiển thị: ["/", "/products", ...]
  displayFrequency String @default("every_visit") // every_visit | once_per_session | once_per_day
  delay       Int      @default(0)        // Delay trước khi hiện (ms)

  // Lịch hiển thị
  active      Boolean  @default(false)
  startDate   DateTime?
  endDate     DateTime?

  // Thống kê
  impressions Int      @default(0)
  clicks      Int      @default(0)

  // Liên kết chiến dịch
  campaign    Campaign? @relation(fields: [campaignId], references: [id])
  campaignId  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("popups")
}

// ─── Site Settings ──────────────────────────────────────
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("site_settings")
}
