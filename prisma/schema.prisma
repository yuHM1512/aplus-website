// Prisma Schema - Aplus Technologies
// Production: Neon PostgreSQL (Singapore)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth ───────────────────────────────────────────────
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

// ─── Blog ───────────────────────────────────────────────
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // AI metadata
  aiGenerated Boolean  @default(false)
  aiModel     String?
  aiPrompt    String?

  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  String?
  tags        Tag[]

  @@map("posts")
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]

  @@map("categories")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]

  @@map("tags")
}

// ─── Contact / Survey Form ──────────────────────────────
model ContactSubmission {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String?
  needType    String
  description String?
  status      String   @default("new") // new | read | replied
  createdAt   DateTime @default(now())

  @@map("contact_submissions")
}

// ─── Products ───────────────────────────────────────────
model Product {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  image         String?
  category      String?
  categoryName  String?
  brand         String?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  price         String?          // Display string: "990.000"
  priceOriginal String?
  priceNumeric  Int?             // Giá tính toán (VNĐ), dùng cho cart
  badge         String?
  specs         String?          // JSON string for technical specs
  stock         Int      @default(-1) // -1 = không quản lý tồn kho, 0 = hết hàng
  sku           String?          // Mã sản phẩm
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("products")
}

// ─── Orders ─────────────────────────────────────────────
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique  // APL-YYYYMMDD-XXX
  status        String      @default("pending")
                // pending → confirmed → shipping → delivered → cancelled
  paymentMethod String      // bank_transfer | cod
  paymentStatus String      @default("unpaid") // unpaid | paid

  // Thông tin khách hàng
  fullName      String
  phone         String
  email         String
  province      String
  district      String
  ward          String
  address       String
  note          String?

  // Tổng tiền (VNĐ)
  subtotal      Int
  shippingFee   Int         @default(30000)
  total         Int

  // Khách bấm "Tôi đã chuyển khoản" — timestamp để admin đối soát
  paymentNotifiedAt DateTime?

  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  productName  String  // Snapshot tên SP tại thời điểm đặt
  productImage String?
  productSlug  String?
  price        Int     // Giá tại thời điểm đặt (VNĐ)
  quantity     Int

  @@map("order_items")
}

// ─── Site Settings ──────────────────────────────────────
model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@map("site_settings")
}
